# Public Firebase web-app configuration; never put Admin credentials in VITE_ variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Server only. Export into the server process (Vite does not load this for Express).
GCLOUD_PROJECT=
# Use Application Default Credentials / a managed runtime identity.
# Never commit service account JSON. Production rejects emulator endpoints.
